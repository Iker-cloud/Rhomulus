{
  "name": "JuegoZombies-Menu",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$className": "Folder",
        "Places": {
          "$path": "src/shared/Places.luau"
        },
        "Difficulties": {
          "$path": "src/shared/Difficulties.luau"
        },
        "HelpContent": {
          "$path": "src/shared/HelpContent.luau"
        },
        "Progress": {
          "$path": "src/shared/Progress.luau"
        },
        "Cosmetics": {
          "$path": "src/shared/Cosmetics.luau"
        },
        "Accessories": {
          "$path": "src/shared/Accessories.luau"
        },
        "Lang": {
          "$path": "src/shared/Lang.luau"
        },
        "LangEs": {
          "$path": "src/shared/LangEs.luau"
        },
        "WeaponModel": {
          "$path": "src/server/WeaponModel.luau"
        },
        "MeleeData": {
          "$className": "Folder",
          "MeleeKnife": { "$path": "src/server/ZombieData/MeleeKnife.luau" },
          "MeleePan": { "$path": "src/server/ZombieData/MeleePan.luau" },
          "MeleeBat": { "$path": "src/server/ZombieData/MeleeBat.luau" },
          "MeleeMachete": { "$path": "src/server/ZombieData/MeleeMachete.luau" },
          "MeleeAxe": { "$path": "src/server/ZombieData/MeleeAxe.luau" },
          "MeleeChainsaw": { "$path": "src/server/ZombieData/MeleeChainsaw.luau" }
        }
      }
    },
    "StarterGui": {
      "$ignoreUnknownInstances": true,
      "$properties": {
        "ScreenOrientation": "LandscapeSensor"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src-menu/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 0
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src-menu/server"
      }
    }
  }
}