{
  "name": "JuegoZombies-Menu",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Shared": {
        "$className": "Folder",
        "Places": {
          "$path": "src/shared/Places.luau"
        },
        "Difficulties": {
          "$path": "src/shared/Difficulties.luau"
        },
        "HelpContent": {
          "$path": "src/shared/HelpContent.luau"
        }
      }
    },
    "StarterPlayer": {
      "$properties": {
        "EnableMouseLockOption": false
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src-menu/client"
        }
      }
    },
    "Lighting": {
      "$properties": {
        "Ambient": [
          0,
          0,
          0
        ],
        "Brightness": 0
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src-menu/server"
      }
    }
  }
}